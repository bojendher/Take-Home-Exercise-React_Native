{
  "expo": {
    "name": "equipment-appraisal",
    "slug": "equipment-appraisal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.appnity_technologies.equipmentappraisal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can attach equipment images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera so you can photograph equipment.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "scheme": "equipmentappraisal",
    "experiments": {
      "typedRoutes": true
    }
  }
}
